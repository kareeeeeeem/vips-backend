# ─── Required ──────────────────────────────────────────────
# The server refuses to start without these two. Booting without them does
# not fail loudly on its own — it fails later as a 500 on whatever endpoint
# is called first, which reads as a bug rather than as missing config.
MONGODB_URI=mongodb://localhost:27017/vips_db
JWT_SECRET=

# ─── Core ──────────────────────────────────────────────────
PORT=3000
# Set to `production` on the live service. It does two things that matter:
# it stops the auto-seeder from writing demo accounts into the real
# database, and it stops internal error messages being returned to callers.
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Public origin of this service; used to build payment webhook callbacks.
BACKEND_URL=http://localhost:3000

# ─── Optional integrations ─────────────────────────────────
# Each of these is optional. When one is missing the feature it powers is
# reported as unconfigured on GET /api/health rather than failing silently
# at the moment a customer tries to use it.

# Social sign-in (Google / Facebook / Apple). The whole service-account JSON
# on one line. Without it, social login cannot verify tokens; email and
# password sign-in is unaffected.
FIREBASE_SERVICE_ACCOUNT=

# Transactional email (verification codes, receipts).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Paymee — local card payments. `mode` is sandbox or live.
PAYMEE_API_KEY=
PAYMEE_MODE=sandbox
PAYMEE_WEBHOOK_URL=

# PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

# Third-party bill and top-up providers.
TELECOM_RECHARGE_API_KEY=
UTILITY_BILLS_API_KEY=

# ─── Set by Render automatically ───────────────────────────
# Not to be configured by hand. They appear in GET /api/health as the build
# marker, which is how you tell which commit is actually serving.
# RENDER_GIT_COMMIT
# RENDER_GIT_BRANCH
